{
  "name": "@cerebro/doc-compression",
  "version": "2.0.0",
  "description": "Deterministic toolkit for LLM documentation compression: token counting, lossless cleanup, and structural verification. Semantic compression is performed by Claude via the bundled Claude Code plugin skill.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "doc-compress": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "jest",
    "prepublishOnly": "npm run build && npm test"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ]
  },
  "files": [
    "dist/",
    ".claude-plugin/",
    "commands/",
    "skills/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rt-heroku/doc-compression.git"
  },
  "bugs": {
    "url": "https://github.com/rt-heroku/doc-compression/issues"
  },
  "homepage": "https://github.com/rt-heroku/doc-compression#readme",
  "keywords": [
    "documentation",
    "compression",
    "claude-code",
    "plugin",
    "knowledge-base",
    "tokens",
    "llm"
  ],
  "author": "Cerebro Team",
  "license": "MIT",
  "dependencies": {
    "glob": "^10.3.10",
    "gpt-tokenizer": "^3.4.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
